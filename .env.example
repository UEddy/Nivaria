# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Session secret. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# REQUIRED: change this before deploying to production
SESSION_SECRET=your_64_char_random_hex_session_secret_here

# Comma-separated emails allowed to view /admin/* pages (e.g. the waitlist).
# Empty/unset = no admins (everyone gets 403). Set this in Railway for prod.
ADMIN_EMAILS=

# Resend (email delivery for OTP codes)
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=Nivaria <onboarding@resend.dev>

# Anthropic AI (required for change analysis)
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Taste Gap (Qloo hackathon) ────────────────────────────────────────────────
# Qloo Taste AI. The hackathon key only works on the hackathon base URL;
# staging and production answer 401. See src/qloo/client.js.
QLOO_API_KEY=your_qloo_api_key_here
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Which models run the Taste Gap agent, in order. When a model fails with a
# 429, a 5xx or a timeout after one retry (or cannot run at all: bad key,
# unknown model), the run moves to the next entry. Entries are a provider
# (gemini, groq, openrouter, zai, anthropic) or provider:model; "openrouter"
# alone means every model in OPENROUTER_MODELS. Providers with a blank key are
# skipped. Unset, the chain is: gemini, gemini:<GEMINI_SECOND_MODEL>, groq,
# openrouter. Z.ai failed its trial run on 2026-10-29 (free tier overloaded),
# so add it explicitly if you want it. See src/taste/llm.js.
# Example: LLM_CHAIN=gemini,gemini:gemini-3.5-flash,groq,openrouter,zai
# LLM_CHAIN=scripted runs the scripted stand-in instead of a model: a fixed
# script over the real Qloo tools, for building and demoing with no model key
# (src/taste/scripted.js). For no Qloo key either, preload the fake Qloo:
#   LLM_CHAIN=scripted node -r ./scripts/qloo-fake.js src/server.js
LLM_CHAIN=
# Older single-provider setting. With LLM_CHAIN unset, this provider is moved
# to the front of the default chain.
LLM_PROVIDER=gemini

# Google Gemini through its OpenAI-compatible endpoint. Key from
# https://aistudio.google.com/apikey. GEMINI_MODEL defaults to gemini-3.6-flash
# and GEMINI_SECOND_MODEL to gemini-3.5-flash. The free tier allows 20 requests
# a day per model, so the second model is a separate quota.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=
GEMINI_SECOND_MODEL=

# Groq through its OpenAI-compatible endpoint. Key from
# https://console.groq.com/keys. GROQ_MODEL is optional and defaults to
# qwen/qwen3.8-27b (parallel tool calls). Free keys allow 8K tokens a minute
# and reject any request over 7K input tokens, so the agent trims older tool
# results to GROQ_INPUT_BUDGET estimated tokens (default 5500). Raise it on a
# paid tier, or set 0 for no trimming.
# Free keys also cap output at 1,000 tokens a minute, so GROQ_MAX_TOKENS
# defaults to 950; raise it on a paid tier.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=
GROQ_INPUT_BUDGET=
GROQ_MAX_TOKENS=

# OpenRouter free models (ids ending in :free). Key from
# https://openrouter.ai/keys. OPENROUTER_MODELS is a comma-separated list tried
# in order; leave it blank for the tested defaults in src/taste/llm.js. Free
# models allow 20 requests a minute and 50 a day (1000 a day once 10 credits
# have been bought).
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODELS=

# Z.ai (international endpoint, api.z.ai). Key from the API keys page of your
# Z.ai account. ZAI_MODEL defaults to glm-4.7-flash, the free GLM Flash model
# (GLM-5.3-Flash is paid). Not in the default chain; add "zai" to LLM_CHAIN.
ZAI_API_KEY=your_zai_api_key_here
ZAI_MODEL=

# ── Outbound (admin-only lead-gen) ────────────────────────────────────────────
# Web-search API used for lead discovery and people-finding. Get a key at
# https://serper.dev (free/low tier). Without it the Outbound feature still
# loads, but starting a run returns a clear "discovery not configured" error.
# Contacts are never fabricated: Phase 1 stores a profile link marked 'manual'.
SERPER_API_KEY=your_serper_api_key_here

# Web3 discovery segment (optional). When a run selects the "web3" segment,
# discovery also pulls crypto funding rounds from the last 6 months and ranks
# them alongside the search leads. Both keys are optional: without them the
# segment simply reports the source as unavailable and the search path still
# runs. See src/outbound/cryptoSources.js.
#
# DeFiLlama raises. NOTE: the old free https://api.llama.fi/raises endpoint now
# answers 402, so this source needs a paid key from
# https://defillama.com/subscription (the request goes to
# https://pro-api.llama.fi/{key}/api/raises).
DEFILLAMA_API_KEY=your_defillama_pro_api_key_here
# CryptoRank funding rounds (secondary source, used to fill gaps and corroborate).
# Key from https://cryptorank.io/public-api/dashboard. The funding-rounds feed
# needs the Pro tier; a lower tier returns 403 and the source is skipped.
CRYPTORANK_API_KEY=your_cryptorank_api_key_here

# ── Sign in with Google (identity/login) ──────────────────────────────────────
# IDENTITY login only, separate from the Google Calendar integration below.
# Requests only basic profile and email scopes (never Calendar).
#
# Credentials are SHARED with the Calendar integration: login reuses the SAME
# GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET defined further down
# (same Google Cloud project, same OAuth client). There is no separate login
# client id/secret, so the same secret is never duplicated under two names that
# could drift when rotated.
#
# Only the redirect URI is its own variable, because the login callback
# (/api/auth/google/callback) is a DIFFERENT endpoint from the Calendar callback
# (GOOGLE_OAUTH_REDIRECT_URI). Both callback URLs must be added to the shared
# OAuth client's Authorized redirect URIs in Google Cloud Console:
#   1. https://console.cloud.google.com/apis/credentials, open the OAuth client.
#   2. Authorized redirect URIs: add exactly the value of GOOGLE_LOGIN_REDIRECT_URI
#      below (for production also add https://nivaria.app/api/auth/google/callback).
#   3. OAuth consent screen: ensure the "email", "profile", and "openid" scopes are
#      allowed. These are default non-sensitive scopes, so no Google review is
#      needed for login.
# Leave GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET blank to hide the
# "Sign in with Google" button (the app degrades cleanly).
#
# Login callback URL. Optional: defaults to `${APP_URL}/api/auth/google/callback`
# when unset. Set it explicitly if APP_URL is not the externally reachable URL.
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional: default Slack/Discord webhooks for all users
DEFAULT_SLACK_WEBHOOK=
DEFAULT_DISCORD_WEBHOOK=

# ── Phase 7: Calendar OAuth (pre-meeting briefings) ───────────────────────────
# Encryption key for calendar OAuth tokens at rest. AES-256-GCM, 32 bytes hex.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED before any calendar can be connected.
CALENDAR_TOKEN_ENCRYPTION_KEY=your_64_char_random_hex_calendar_key_here

# Google Calendar OAuth (required to connect a Google account).
# 1. Open https://console.cloud.google.com/apis/credentials
# 2. Create a new project (or pick one), then "Create Credentials" → "OAuth client ID"
# 3. Application type: "Web application"
# 4. Authorized redirect URIs: add exactly the value of GOOGLE_OAUTH_REDIRECT_URI below
# 5. Enable the Google Calendar API for the project (APIs & Services → Library)
# 6. Copy the client ID and secret into these vars
# NOTE: "Sign in with Google" (login) reuses these SAME two credentials (see the
# Sign in with Google section above). Its callback lives under its own variable,
# GOOGLE_LOGIN_REDIRECT_URI, which must also be added to this client's Authorized
# redirect URIs.
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# Microsoft 365 Calendar OAuth — stubbed for now (UI shows "Coming soon").
# When implemented, register an app at https://entra.microsoft.com → "App registrations".
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/api/calendar/microsoft/callback

# Set to any truthy value (e.g. 1) to emit verbose [calendar:connect] /
# [calendar:callback] log lines while diagnosing OAuth flow issues. Off by
# default — tokens are already redacted in those lines, but silencing them
# in production keeps log volume bounded.
OAUTH_DEBUG=

# ── Phase 9: Slack deal logging (win/loss + ROI) ──────────────────────────────
# Lets users log deals from Slack with: /foresight lost-deal Acme $40K vs BambooHR
#
# 1. Create a Slack app at https://api.slack.com/apps -> "From scratch".
# 2. Basic Information -> App Credentials -> copy the "Signing Secret" here.
#    This is REQUIRED: the slash command endpoint rejects any request that
#    isn't correctly signed by Slack (with a 5-minute replay window).
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
#
# 3. OAuth & Permissions -> Bot Token Scopes -> add "commands".
#    Redirect URLs -> add exactly the value of SLACK_REDIRECT_URI below.
#    Copy the Client ID / Client Secret from Basic Information -> App Credentials.
#    (Leave these blank to hide the in-app "Add to Slack" button; signature
#    verification still works for a manually configured slash command.)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/slack/oauth/callback
#
# 4. Slash Commands -> Create New Command:
#      Command:           /foresight
#      Request URL:       https://YOUR_HOST/api/slack/commands
#      Short description: Log a win/loss deal outcome
#      Usage hint:        lost-deal Acme $40K vs BambooHR
# 5. Interactivity & Shortcuts -> turn on, Request URL:
#      https://YOUR_HOST/api/slack/interactions
#    (Needed for the competitor-picker buttons when a name doesn't match.)

# ── Telegram admin signup alerts (internal, founder-only) ──────────────────────
# Private heads-up to the founder's Telegram whenever a new user signs up,
# including the total user count. Not a customer feature and unrelated to the
# Slack/Discord competitor webhooks above. Both must be set for alerts to send;
# if either is empty it is a clean no-op. Set these in Railway for production.
#   1. Create a bot with @BotFather and copy the token into TELEGRAM_BOT_TOKEN.
#   2. Message the bot once, then get your chat id (e.g. via @userinfobot) and
#      put it in TELEGRAM_ADMIN_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
